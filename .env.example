# Angel — chat. The first key found is used. Without a key, Angel runs the local brain.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Premium voice. Leave NEXT_PUBLIC_TTS_PROVIDER empty to use the browser voice (speechSynthesis).
# elevenlabs | openai
NEXT_PUBLIC_TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Checkout. Card numbers are never accepted by these routes.
# When both keys exist, /api/checkout creates a Stripe PaymentIntent.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
